# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser.

# Public site URL (used for metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://shoreofsaiyad.com

# Store contact details
NEXT_PUBLIC_SUPPORT_EMAIL=support@shoreofsaiyad.com
NEXT_PUBLIC_SUPPORT_PHONE=+880 1234-567890

# Merchant wallet numbers customers send payments to
NEXT_PUBLIC_BKASH_NUMBER=01234567890
NEXT_PUBLIC_NAGAD_NUMBER=01234567890

# Social links (leave empty to hide the icon)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Admin area (/admin). Leave ADMIN_PASSWORD empty to disable admin access entirely.
ADMIN_PASSWORD=
# Optional extra secret mixed into the session token; rotate to sign everyone out.
ADMIN_SESSION_SECRET=

# Google AI (Gemini) key for the AI product-description tool in /admin
GEMINI_API_KEY=
